 "html": "<div class=\"container\">\n    <h3 class=\"text-center\">Payment Receipt</h3>\n    <div class=\"card p-3\">\n        \n        <!-- First Row -->\n        <div class=\"row\">\n            <div class=\"col-md-6\">\n                <p><strong>Receipt No:</strong> {{ doc.name }}</p>\n                <p><strong>Start Date:</strong> {{ frappe.utils.formatdate(doc.start_date) }}</p>\n                <p><strong>End Date:</strong> {{ frappe.utils.formatdate(doc.end_date) }}</p>\n            </div>\n            <div class=\"col-md-6\">\n                <p><strong>Shop Name:</strong> {{ doc.shop_name }}</p>\n                <p><strong>Tenant Name:</strong> {{ doc.tenant }}</p>\n                <p><strong>Payment Status:</strong> <span class=\"text-success font-weight-bold\">{{ doc.payment_status }}</span></p>\n            </div>\n        </div>\n        \n        <hr>\n        \n        <!-- Second Row -->\n        <div class=\"row\">\n            <div class=\"col-12 text-center\">\n                <h4 class=\"text-success\">\u20b9 {{ \"{:,.2f}\".format(doc.monthly_rent_amount) }}</h4>\n                <p class=\"font-weight-bold\">Monthly Rent</p>\n            </div>\n        </div>\n        \n    </div>\n\n    <hr>\n    <p class=\"text-center\">\n        Thank you for your payment! For inquiries, contact our office.<br>\n        <em>Generated by Frappe ERP System</em>\n    </p>\n</div>\n",
